{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/elementals/creature.schema.json",
  "title": "A creature card: its cost, which sets its element, and its power and toughness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cost", "power", "toughness"],
  "properties": {
    "cost": { "$ref": "common.schema.json#/$defs/Cost" },
    "power": { "$ref": "common.schema.json#/$defs/Stat" },
    "toughness": { "$ref": "common.schema.json#/$defs/Stat" },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["swift", "guard", "drain"] } },
    "text": { "$ref": "common.schema.json#/$defs/Text" }
  }
}
