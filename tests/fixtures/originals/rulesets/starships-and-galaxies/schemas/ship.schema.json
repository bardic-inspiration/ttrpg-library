{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/starships-and-galaxies/ship.schema.json",
  "title": "A ship: its size, which sets its crew and hull, and a rating for each system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["size", "systems", "cargo", "fuel", "price"],
  "properties": {
    "size": { "enum": ["scout", "frigate", "cruiser", "carrier"], "display": "chip" },
    "systems": { "$ref": "common.schema.json#/$defs/Systems" },
    "cargo": { "description": "Cargo holds, each carrying one trade good.", "type": "integer", "minimum": 0 },
    "fuel": { "description": "Jumps on a full tank.", "type": "integer", "minimum": 1, "maximum": 10 },
    "price": { "$ref": "common.schema.json#/$defs/Credits" },
    "traits": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Trait" } }
  }
}
