{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/starships-and-galaxies/celestial-body.schema.json",
  "title": "A place in the galaxy: what it orbits, the services a docked ship finds there, and the hazards on the way in.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "text"],
  "properties": {
    "kind": { "enum": ["star", "planet", "moon", "asteroid-field"] },
    "orbits": { "$ref": "common.schema.json#/$defs/CelestialRef" },
    "services": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["trade", "refuel", "discovery"] } },
    "hazards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Hazard" } },
    "text": { "$ref": "common.schema.json#/$defs/Text" }
  },
  "$defs": {
    "Hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "difficulty", "text"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["environmental", "hostile"] },
        "station": { "$ref": "common.schema.json#/$defs/StationRef" },
        "ship": { "$ref": "common.schema.json#/$defs/ShipRef" },
        "difficulty": { "$ref": "common.schema.json#/$defs/Difficulty" },
        "damage": { "description": "Hull damage on a failed check, in d10s.", "type": "integer", "minimum": 1, "maximum": 10 },
        "text": { "$ref": "common.schema.json#/$defs/Text" }
      },
      "if": { "properties": { "kind": { "const": "environmental" } } },
      "then": { "required": ["station"], "not": { "required": ["ship"] } },
      "else": { "required": ["ship"], "not": { "required": ["station"] } }
    }
  }
}
