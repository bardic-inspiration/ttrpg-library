{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/fixture-rules/manual.schema.json",
  "description": "A page type: its chapters are components, listed in order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapters"
  ],
  "properties": {
    "text": {
      "$ref": "common.schema.json#/$defs/Text"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/ChapterRef"
      }
    }
  }
}
