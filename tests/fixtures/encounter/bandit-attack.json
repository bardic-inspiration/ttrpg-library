            "items": [{ "ref": "equipment/potion-of-healing", "count": 1 }]
          },
          {
            "difficulty": "high",
            "coins": { "roll": "4d6", "times": 10, "unit": "gp" },
            "items": [
              { "ref": "equipment/potion-of-healing", "count": 2 },
              { "ref": "item/cloak-of-elvenkind", "count": 1, "show": "card" }
            ]
          }
        ]
      }
    ]
