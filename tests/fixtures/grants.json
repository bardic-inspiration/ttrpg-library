{
  "class/bard": {
    "grants": {
      "start": [{ "kind": "tools", "count": 3, "from": [{ "ref": "equipment/musical-instrument" }] }],
      "multiclass": [
        { "kind": "skills", "count": 1 },
        { "kind": "tools", "count": 1, "from": [{ "ref": "equipment/musical-instrument" }] }
      ]
    },
    "training": { "start": { "weapons": [{ "group": "simple-weapons" }], "armor": ["light-armor"] }, "multiclass": { "armor": ["light-armor"] } }
  },
  "class/cleric": {
    "training": {
      "start": { "weapons": [{ "group": "simple-weapons" }], "armor": ["light-armor", "medium-armor", "shields"] },
      "multiclass": { "armor": ["light-armor", "medium-armor", "shields"] }
    }
  },
  "class/fighter": {
    "training": {
      "start": { "weapons": [{ "group": "simple-weapons" }, { "group": "martial-weapons" }], "armor": ["light-armor", "medium-armor", "heavy-armor", "shields"] },
      "multiclass": { "weapons": [{ "group": "martial-weapons" }], "armor": ["light-armor", "medium-armor", "shields"] }
    }
  },
  "class/monk": {
    "training": { "start": { "weapons": [{ "group": "simple-weapons" }, { "group": "martial-weapons", "properties": [{ "ref": "weapon-property/light" }] }] } }
  },
  "class/wizard": {
    "training": { "start": { "weapons": [{ "group": "simple-weapons" }] } }
  },
  "class-feature/fighter-fighting-style": {
    "grants": [{ "kind": "feat", "categories": ["fighting-style"] }]
  },
  "class-feature/fighter-ability-score-improvement": {
    "grants": [{ "kind": "feat", "categories": ["origin", "general"] }]
  },
  "class-feature/bard-expertise": {
    "grants": [{ "kind": "expertise", "count": 2 }]
  },
  "class-feature/wizard-scholar": {
    "grants": [{ "kind": "expertise", "count": 1, "from": ["arcana", "history", "investigation", "medicine", "nature", "religion"] }]
  },
  "class-feature/sorcerer-metamagic": {
    "grants": [{ "kind": "options", "list": "Metamagic Options", "byLevel": { "2": 2, "10": 4, "17": 6 } }]
  },
  "class-feature/warlock-eldritch-invocations": {
    "grants": [{ "kind": "options", "list": "Eldritch Invocation Options", "column": "Eldritch Invocations" }]
  },
  "class-feature/life-domain-life-domain-spells": {
    "grants": [
      {
        "kind": "spells",
        "byLevel": {
          "3": [{ "ref": "spell/aid" }, { "ref": "spell/bless" }, { "ref": "spell/cure-wounds" }, { "ref": "spell/lesser-restoration" }],
          "5": [{ "ref": "spell/mass-healing-word" }, { "ref": "spell/revivify" }],
          "7": [{ "ref": "spell/aura-of-life" }, { "ref": "spell/death-ward" }],
          "9": [{ "ref": "spell/greater-restoration" }, { "ref": "spell/mass-cure-wounds" }]
        }
      }
    ]
  },
  "species-trait/human-versatile": {
    "grants": [{ "kind": "feat", "categories": ["origin"] }]
  },
  "species-trait/human-skillful": {
    "grants": [{ "kind": "skills", "count": 1 }]
  },
  "species-trait/elf-keen-senses": {
    "grants": [{ "kind": "skills", "count": 1, "from": ["insight", "perception", "survival"] }]
  },
