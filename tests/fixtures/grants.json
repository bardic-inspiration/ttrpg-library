    "requires": { "abilities": ["str", "dex"], "min": 13 }
  },
  "feat/magic-initiate": {
    "grants": [{ "kind": "spells", "cantrips": 2, "level1": 1, "from": [{ "ref": "class/cleric" }, { "ref": "class/druid" }, { "ref": "class/wizard" }] }]
  },
  "feat/skilled": {
    "grants": [{ "kind": "skills", "count": 3, "withTools": true }]
