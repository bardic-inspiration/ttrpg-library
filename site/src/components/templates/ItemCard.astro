---
// The dnd-5e-2024 magic item card (registry template `item-card`,
// docs/rulesets.md#items, docs/site.md#templates): name, category, rarity and attunement, the rules text,
// then charges, the spells the item casts, and any stat blocks it prints. The accent follows the rarity.
// Optional fields display only when present (docs/content-model.md#situational-fields).
import type { ItemStats } from '../../../../rulesets/dnd-5e-2024/types.ts';
import { present, whenPresent } from '../../lib/display';
import { chargesLine, spellLine, subtitleMarkdown } from '../../lib/item';
import { baseLookup, loadRules } from '../../lib/rules';
import type { PropertyLine, TemplateProps } from '../../lib/template';
import PropertyList from './parts/PropertyList.astro';
import RulesText from './parts/RulesText.astro';
import StatBlock from './parts/StatBlock.astro';
import StatBlockHeader from './parts/StatBlockHeader.astro';
import Heading from './parts/Heading.astro';
import EmbeddedStatBlock from './parts/EmbeddedStatBlock.astro';
import type { DerivedStatBlock } from '../../../../rulesets/dnd-5e-2024/types.ts';

type Props = TemplateProps;

const { entry, derived, names, paths, mode, level = 2 } = Astro.props;
const blocks = (derived as { statBlocks?: DerivedStatBlock[] }).statBlocks ?? [];
const refs = { names, ruleset: entry.ruleset, paths };
const s = entry.stats as ItemStats;
const charges = chargesLine(s);
const properties: PropertyLine[] = [
  ...(present(charges) ? [{ label: 'Charges', value: charges }] : []),
  ...(present(s.cursed) ? [{ label: 'Cursed', value: 'Yes' }] : []),
];
const spells = whenPresent(s.spells, (list) => list.map((spell) => spellLine(spell, names)));
// The base item's targets link to their anchors on the equipment pages.
const subtitle = { markdown: subtitleMarkdown(s, baseLookup(loadRules())), refs };
---
<StatBlock name={`${entry.name} magic item`} type="item" rarity={s.rarity} mode={mode}>
  <StatBlockHeader name={entry.name} subtitle={subtitle} level={level} />
  <RulesText text={s.effect} refs={refs} />
  {properties.length > 0 && <PropertyList lines={properties} />}
  {present(s.charges?.depletion) && <RulesText text={s.charges.depletion} refs={refs} />}
  {present(spells) && (
    <section class="item-card__spells">
      <Heading level={level + 1} class="item-card__heading">Spells</Heading>
      <ul>
        {spells.map((spell) => <li>{spell.name}{present(spell.notes) && ` (${spell.notes})`}</li>)}
      </ul>
    </section>
  )}
  {present(s.statBlocks) && s.statBlocks.map((block, i) => <EmbeddedStatBlock block={block} derived={blocks[i]!} level={level + 1} refs={refs} />)}
</StatBlock>

<style>
  @layer components {
    .item-card__spells :global(.item-card__heading) {
      font-family: var(--statblock-heading-font);
      font-size: var(--text-h4);
      color: var(--accent);
      margin-block-end: var(--space-3xs);
    }

    .item-card__spells ul {
      padding-inline-start: var(--space-m);
    }
  }
</style>
