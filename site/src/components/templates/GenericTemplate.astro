---
// The fallback for a type with no template of its own (`generic`,
// docs/site.md#templates): the fixed keys, `stats` and then the ruleset's derived values as one
// definition list, and tags. Text in `stats` renders the ruleset's text tokens
// (docs/rulesets.md#text-tokens) through its module. Optional
// fields display by presence alone (docs/content-model.md#situational-fields): an omitted key has no line, and a
// present one always does, even at 0 or false.
import { renderMarkdown } from '../../lib/markdown';
import { present } from '../../lib/display';
import { genericLines } from '../../lib/generic';
import { rulesetModule } from '../../lib/library';
import type { TemplateProps } from '../../lib/template';
import PropertyList from './parts/PropertyList.astro';
import StatBlock from './parts/StatBlock.astro';
import StatBlockHeader from './parts/StatBlockHeader.astro';

type Props = TemplateProps;

const { entry, derived, names, paths, mode, level = 2 } = Astro.props;
const refs = { names, ruleset: entry.ruleset, paths };
const { renderTokens } = Astro.props.module ?? rulesetModule(entry.ruleset);
const tokens = (text: string) => renderTokens?.(entry.type, text, derived) ?? text;
const tags = Object.entries(entry.tags ?? {}).map(([key, value]) => ({
  label: key,
  value: Array.isArray(value) ? value.join(', ') : String(value),
}));
---
<StatBlock name={entry.name} type={entry.type} mode={mode}>
  <StatBlockHeader name={entry.name} subtitle={entry.summary} level={level} />
  {present(entry.description) && <div class="generic__description" set:html={renderMarkdown(entry.description, refs)} />}
  <PropertyList lines={[...genericLines(entry.stats, names, '', [], tokens), ...genericLines(derived, names)]} refs={refs} />
  {tags.length > 0 && <PropertyList lines={tags} />}
</StatBlock>
