---
// Renders an entry with its type's template (docs/site.md#type-registry `template`, docs/site.md#templates),
// or the generic fallback when the registry names none this site has, then a page type's
// components (docs/content-model.md#components).
import { PLACES_COMPONENTS, templateFor, type TemplateProps } from '../../lib/template';
import registry from '../../../../config/types.json';
import BackgroundCard from './BackgroundCard.astro';
import ClassPage from './ClassPage.astro';
import ConditionCard from './ConditionCard.astro';
import CreatureStatBlock from './CreatureStatBlock.astro';
import EquipmentCard from './EquipmentCard.astro';
import FeatCard from './FeatCard.astro';
import GenericTemplate from './GenericTemplate.astro';
import ItemCard from './ItemCard.astro';
import PageComponents from './parts/PageComponents.astro';
import SpeciesPage from './SpeciesPage.astro';
import SpellCard from './SpellCard.astro';
import SubclassPage from './SubclassPage.astro';

type Props = TemplateProps;

const { entry, names, paths, components: parts = [], level = 2 } = Astro.props;
const types = (registry as Record<string, { types: Record<string, { template?: string }> }>)[entry.ruleset]?.types;
const templates = {
  'background-card': BackgroundCard,
  'class-page': ClassPage,
  'condition-card': ConditionCard,
  'creature-stat-block': CreatureStatBlock,
  'equipment-card': EquipmentCard,
  'feat-card': FeatCard,
  'item-card': ItemCard,
  'species-page': SpeciesPage,
  'spell-card': SpellCard,
  'subclass-page': SubclassPage,
  generic: GenericTemplate,
};
const name = templateFor(types?.[entry.type]?.template);
const Template = templates[name];
---
<Template {...Astro.props} />
{parts.length > 0 && !PLACES_COMPONENTS.includes(name) && <PageComponents components={parts} refs={{ names, ruleset: entry.ruleset, paths }} level={level + 1} />}
