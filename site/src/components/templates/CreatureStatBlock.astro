---
// The dnd-5e-2024 creature stat block (registry template `creature-stat-block`,
// docs/rulesets.md#creatures, docs/site.md#templates), composed of part components. Optional fields display
// only when present (docs/content-model.md#situational-fields), through lib/display. Every number comes from the
// derived values; nothing here computes a rules value.
import type { CreatureStats, DerivedCreature } from '../../../../rulesets/dnd-5e-2024/types.ts';
import {
  abilityRows,
  acLine,
  actionBlock,
  crLine,
  defenseLines,
  gearLine,
  hpLine,
  initiativeLine,
  languagesLine,
  legendaryIntro,
  sensesLine,
  sizeTypeLine,
  skillsLine,
  speedLine,
  spellcastingBlock,
  type ActionBlock,
} from '../../lib/creature';
import { present, whenPresent } from '../../lib/display';
import type { PropertyLine, TemplateProps } from '../../lib/template';
import AbilityTable from './parts/AbilityTable.astro';
import ActionList from './parts/ActionList.astro';
import PropertyList from './parts/PropertyList.astro';
import RulesText from './parts/RulesText.astro';
import StatBlock from './parts/StatBlock.astro';
import StatBlockHeader from './parts/StatBlockHeader.astro';

type Props = TemplateProps;

const { entry, derived, names, paths, mode, level = 2 } = Astro.props;
const refs = { names, ruleset: entry.ruleset, paths };
const s = entry.stats as CreatureStats;
const d = derived as unknown as DerivedCreature;
const blocks = (list: 'traits' | 'actions' | 'bonusActions' | 'reactions'): ActionBlock[] | undefined =>
  whenPresent(s[list], (actions) => actions.map((action, i) => actionBlock(action, d[list][i], d)));
const spellcasting = spellcastingBlock(s, d, names, entry.name);
// Actions gathers two optional sources, so an empty result means no section.
const whenNonEmpty = (items: ActionBlock[]): ActionBlock[] | undefined => (items.length > 0 ? items : undefined);
// Each section displays only when it has items; Actions also holds Spellcasting.
const sections = [
  { title: 'Traits', items: blocks('traits') },
  { title: 'Actions', items: whenNonEmpty([...(blocks('actions') ?? []), ...(present(spellcasting) ? [spellcasting] : [])]) },
  { title: 'Bonus Actions', items: blocks('bonusActions') },
  { title: 'Reactions', items: blocks('reactions') },
].filter((section): section is { title: string; items: ActionBlock[] } => present(section.items));
const legendary = s.legendaryActions;
const legendaryItems = (legendary?.items ?? []).map((action, i) => actionBlock(action, d.legendaryActions.items[i], d));
const skills = skillsLine(s, d);
const gear = gearLine(s, names);
const core: PropertyLine[] = [
  { label: 'AC', value: acLine(s) },
  { label: 'Initiative', value: initiativeLine(d) },
  { label: 'HP', value: hpLine(d) },
  { label: 'Speed', value: speedLine(s) },
];
const details: PropertyLine[] = [
  ...(present(skills) ? [{ label: 'Skills', value: skills }] : []),
  ...defenseLines(s),
  ...(gear ? [gear] : []),
  { label: 'Senses', value: sensesLine(s, d) },
  { label: 'Languages', value: languagesLine(s) },
  { label: 'CR', value: crLine(s, d) },
];
---
<StatBlock name={`${entry.name} stat block`} type="creature" mode={mode}>
  <StatBlockHeader name={entry.name} subtitle={sizeTypeLine(s)} level={level} />
  <PropertyList lines={core} refs={refs} />
  <AbilityTable rows={abilityRows(s, d)} />
  <PropertyList lines={details} refs={refs} />
  {sections.map((section) => <ActionList title={section.title} items={section.items} level={level + 1} refs={refs} />)}
  {legendary && (
    <ActionList title="Legendary Actions" items={legendaryItems} level={level + 1} refs={refs}>
      <RulesText text={legendaryIntro(legendary, d)} refs={refs} />
    </ActionList>
  )}
</StatBlock>
