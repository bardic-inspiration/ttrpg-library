---
// A markdown-subset rules-text field (SPEC.md §5.5), optionally led by a bold
// label such as "Using a Higher-Level Spell Slot." or an action's name. The
// label is plain text, so it is escaped before it joins the markdown.
// `refs` turns `{ref:…}` tokens into links (§5.7).
import { escapeMarkdown, renderMarkdown, type TextRefs } from '../../../lib/markdown';

interface Props {
  text: string;
  label?: string;
  class?: string;
  refs?: TextRefs;
}

const { text, label, class: className, refs } = Astro.props;
const html = renderMarkdown(label ? `**${escapeMarkdown(label)}.** ${text}` : text, refs);
---
<div class:list={['rules-text', className]} set:html={html} />

<style>
  @layer components {
    .rules-text > :global(* + *) {
      margin-block-start: var(--space-2xs);
    }

    .rules-text :global(ul),
    .rules-text :global(ol) {
      padding-inline-start: var(--space-m);
    }
  }
</style>
