---
// The frame every type template renders in (docs/site.md#templates, docs/styling.md#tokens): accent from
// `data-type` (and `data-rarity` for items), thin rules between sections, and
// a `mode` that adjusts only spacing (`screen`, `capture`, `print`).
import type { TemplateMode } from '../../../lib/template';

interface Props {
  name: string;
  type: string;
  rarity?: string;
  mode?: TemplateMode;
}

const { name, type, rarity, mode = 'screen' } = Astro.props;
---
<section class="statblock" data-type={type} data-rarity={rarity} data-mode={mode} aria-label={name}>
  <slot />
</section>

<style>
  @layer components {
    .statblock {
      background: var(--statblock-bg);
      border-block: var(--statblock-rule-width) solid var(--statblock-rule-color);
      padding: var(--statblock-padding);
      max-inline-size: var(--measure);

      & > :global(* + *) {
        margin-block-start: var(--statblock-gap);
        padding-block-start: var(--statblock-gap);
        border-block-start: var(--border-width) solid var(--statblock-rule-color);
      }
    }

    /*
     * A stat block's section headings (docs/styling.md#hierarchy-and-standards): Traits, Actions,
     * a class's or species' sections, an embedded stat block's name. A section nested in one
     * reads a step smaller. Their level follows the nesting; their size doesn't.
     */
    .statblock :global(.statblock-heading) {
      font-family: var(--statblock-heading-font);
      font-size: var(--statblock-heading-size);
      color: var(--accent);
    }

    .statblock :global(.statblock-heading--nested) {
      font-size: var(--statblock-subheading-size);
    }
  }
</style>
