---
// A titled stat-block section (Traits, Actions, Reactions…) of named blocks,
// each with its name as an inline heading (docs/site.md#templates). Content before the
// blocks, such as the legendary-action intro, goes in the default slot. Each
// body is markdown (docs/content-model.md#text-fields) and renders through RulesText.
import type { ActionBlock } from '../../../lib/creature';
import type { TextRefs } from '../../../lib/markdown';
import Heading from './Heading.astro';
import RulesText from './RulesText.astro';

interface Props {
  title: string;
  items: ActionBlock[];
  level: number;
  refs?: TextRefs;
}

const { title, items, level, refs } = Astro.props;
---
<section class="action-list">
  <Heading level={level} class="action-list__heading">{title}</Heading>
  <slot />
  {items.map((item) => (
    <RulesText class="action-list__item" label={item.name} text={item.body} refs={refs} />
  ))}
</section>

<style>
  @layer components {
    .action-list :global(.action-list__heading) {
      font-family: var(--statblock-heading-font);
      font-size: var(--text-h4);
      color: var(--accent);
      margin-block-end: var(--space-3xs);
    }

    .action-list > :global(* + *) {
      margin-block-start: var(--space-3xs);
    }
  }
</style>
