---
// The entry name as a heading, and the italic line under it (docs/site.md#templates). The
// subtitle may be segments, some linked to a primitive or group (an item's base item), or inline
// markdown with its refs (a feat's prerequisite).
import { renderInlineMarkdown, type TextRefs } from '../../../lib/markdown';
import { url } from '../../../lib/url';
import Heading from './Heading.astro';

interface Props {
  name: string;
  subtitle: string | { text: string; href?: string }[] | { markdown: string; refs?: TextRefs };
  /** The name's heading level; section headings sit one below it. */
  level: number;
}

const { name, subtitle, level } = Astro.props;
---
<header class="statblock-header">
  <Heading level={level} class="statblock-header__name">{name}</Heading>
  {typeof subtitle === 'object' && 'markdown' in subtitle ? (
    <p class="statblock-header__subtitle" set:html={renderInlineMarkdown(subtitle.markdown, subtitle.refs)} />
  ) : (
    <p class="statblock-header__subtitle">
      {typeof subtitle === 'string'
        ? subtitle
        : subtitle.map((part) => (part.href ? <a class="ref-link" href={url(part.href)}>{part.text}</a> : part.text))}
    </p>
  )}
</header>

<style>
  @layer components {
    .statblock-header :global(.statblock-header__name) {
      font-family: var(--statblock-heading-font);
      font-size: var(--text-h3);
      color: var(--accent);
    }

    .statblock-header__subtitle {
      font-style: italic;
      color: var(--color-text-muted);
    }
  }
</style>
