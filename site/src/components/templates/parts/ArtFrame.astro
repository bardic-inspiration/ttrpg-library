---
// Entry art (docs/content-model.md#images), taking the entry name as alt text. Callers render
// it only when the entry has art; there is no placeholder.
interface Props {
  name: string;
  /** The art's URL. */
  src: string;
}

const { name, src } = Astro.props;
---
<img class="art-frame art-frame--image" src={src} alt={name} />

<style>
  @layer components {
    .art-frame {
      inline-size: 100%;
      border-radius: var(--card-radius);
    }

    .art-frame--image {
      aspect-ratio: var(--art-aspect);
      object-fit: cover;
    }
  }
</style>
