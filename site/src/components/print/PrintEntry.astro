---
// One entry as the print view shows it (docs/export.md#print): the type template in
// `print` mode, sized by the print tokens in tokens/print.css. Two columns
// on a wide page (Letter, A4), one with smaller type on a narrow one
// (Half-Letter, 4 × 6), by printed page width; no
// action or trait is split across a column or page. The print fragments and
// the style guide's print previews both render this.
import type { LoadedEntry } from '../../lib/library';
import EntryTemplate from '../templates/EntryTemplate.astro';

interface Props {
  loaded: LoadedEntry;
  /** `<type>/<id>` → entry name. */
  names: Map<string, string>;
  /** Paths of primitives' and groups' anchors, for links to rules data. */
  paths?: Map<string, string>;
  /** Heading level of the entry name. Default 2, under the print view's `h1`. */
  level?: number;
}

const { loaded, names, paths, level = 2 } = Astro.props;
const { entry, derived } = loaded;
---
<article class="print-entry" data-id={entry.id} data-name={entry.name} data-type={entry.type}>
  <EntryTemplate entry={entry} derived={derived} names={names} paths={paths} components={loaded.components} refBy={loaded.refBy} mode="print" level={level} />
</article>

<style>
  @layer components {
    .print-entry {
      --text-body: var(--print-font-size);
      --text-small: var(--print-small-size);
      --text-h4: var(--print-section-size);
      --text-h3: var(--print-heading-size);
      --text-h5: var(--print-font-size);
      --text-h6: var(--print-font-size);

      /*
       * A custom property resolves where it's declared, so the component size
       * tokens declared on :root as text roles (tokens/components.css) keep their
       * screen sizes here unless they're declared again, against the print roles above.
       */
      --site-title-size: var(--text-h4);
      --card-title-size: var(--text-h4);
      --entry-summary-size: var(--text-h4);
      --statblock-title-size: var(--text-h3);
      --statblock-heading-size: var(--text-h4);
      --statblock-subheading-size: var(--text-h5);

      font-size: var(--text-body);

      & :global(.statblock) {
        max-inline-size: none;
        columns: var(--print-columns);
        column-gap: var(--statblock-column-gap);
      }

      & :global(.statblock-header),
      & :global(.action-list__heading),
      & :global(.action-list__item),
      & :global(.property-list),
      & :global(.ability-table) {
        break-inside: avoid;
      }

      & :global(.action-list__heading) {
        break-after: avoid;
      }
    }
  }
</style>
