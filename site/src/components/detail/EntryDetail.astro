---
// The body of a detail page (docs/site.md#detail-page): art when the entry has it, name,
// type, and summary; the type template; the description as lore; forward refs and
// back-refs (but those into a map's zones, which its template lists), each label's list a disclosure, an official page's links to homebrew in a Homebrew
// section after them; and provenance.
// The page passes its export controls (an island) in the `export` slot.
import type { LoadedEntry } from '../../lib/library';
import { rulesetModule } from '../../lib/library';
import { outsideZones } from '../../lib/map';
import { groupPageRefs, groupRefs, splitHomebrew, type RefTarget } from '../../lib/refs';
import { isOfficial } from '../../../../rulesets/module';
import { provenance } from '../../lib/detail';
import { renderMarkdown } from '../../lib/markdown';
import { present } from '../../lib/display';
import { url } from '../../lib/url';
import { typeLibrary } from '../../lib/gallery/library-url';
import type { Registry } from '../../lib/gallery/config';
import registry from '@library/config/types.json';
import ArtFrame from '../templates/parts/ArtFrame.astro';
import Details from '../shared/Disclosure.astro';
import EntryTemplate from '../templates/EntryTemplate.astro';

interface Props {
  loaded: LoadedEntry;
  /** `<type>/<id>` → entry name. */
  names: Map<string, string>;
  /** `<type>/<id>` → path of a primitive's or group's anchor, for links to rules data. */
  paths?: Map<string, string>;
  /** `<type>/<id>` → link target. */
  targets: Map<string, RefTarget>;
}

const { loaded, names, paths, targets } = Astro.props;
const { entry, derived } = loaded;
const typeLabel =
  (registry as Record<string, { types: Record<string, { label: string }> }>)[entry.ruleset]?.types[entry.type]?.label ?? entry.type;
const module = rulesetModule(entry.ruleset);
const labelFor = (type: string, path: string) => module.refLabels(type, path);
// A page type's links are its own and its components' (docs/content-model.md#components). A
// back-link into one of a map's zones is listed under its zone by the map's template, not again here.
const links = loaded.components
  ? groupPageRefs(loaded, loaded.components, targets, labelFor)
  : groupRefs(entry.type, loaded.refs, outsideZones(loaded.refBy), targets, labelFor);
// An SRD page lists its links to homebrew in a Homebrew section of their own, after its SRD links.
const allGroups = [...links.forward, ...links.back];
const { official: linkGroups, homebrew: homebrewGroups } = isOfficial(entry) ? splitHomebrew(allGroups) : { official: allGroups, homebrew: [] };
const source = provenance(entry);
// A slash isn't a break point, so "Antipathy/Sympathy" could set a phone page's width.
const nameParts = entry.name.split('/');
---
<article class="entry-detail" data-type={entry.type}>
  <header class="entry-detail__header">
    {entry.image && (
      <div class="entry-detail__art">
        <ArtFrame name={entry.name} src={url(entry.image)} />
      </div>
    )}
    <div class="entry-detail__intro">
      <h1>{nameParts.map((part, i) => <>{i > 0 && <>/<wbr /></>}{part}</>)}</h1>
      <p><a class="entry-detail__type" href={url(typeLibrary(registry as unknown as Registry, entry.ruleset, entry.type))}>{typeLabel}</a></p>
      <p class="entry-detail__summary">{entry.summary}</p>
      <slot name="export" />
    </div>
  </header>

  <EntryTemplate entry={entry} derived={derived} names={names} paths={paths} components={loaded.components} refBy={loaded.refBy} mode="screen" level={2} />

  {present(entry.description) && (
    <section class="entry-detail__lore" aria-labelledby="lore-heading">
      <h2 id="lore-heading">Lore</h2>
      <div class="lore" set:html={renderMarkdown(entry.description, { names, ruleset: entry.ruleset, paths })} />
    </section>
  )}

  {[
    { id: 'links-heading', heading: 'Links', groups: linkGroups },
    { id: 'homebrew-heading', heading: 'Homebrew', groups: homebrewGroups },
  ].map(({ id, heading, groups }) => groups.length > 0 && (
    <section aria-labelledby={id}>
      <h2 id={id}>{heading}</h2>
      <div class="entry-detail__links">
        {groups.map((group) => (
          <Details class="entry-detail__refs" summaryClass="entry-detail__refs-label" open>
            <Fragment slot="summary">{group.label}</Fragment>
            <p class="entry-detail__refs-list">
              {group.targets.map((target, i) => (
                <>{i > 0 && ', '}<a href={url(target.path)}>{target.name}</a></>
              ))}
            </p>
          </Details>
        ))}
      </div>
    </section>
  ))}

  <p class="entry-detail__provenance">
    <small>
      Added {source.createdAt}{present(source.updatedAt) && `, revised ${source.updatedAt}`}.
      {source.credit && (
        <>
          {' '}Adapted from <a href={source.credit.source}>a work by {source.credit.author}</a>, licensed under{' '}
          <a href={source.credit.licenseUrl}>{source.credit.license}</a>.
        </>
      )}
    </small>
  </p>
</article>

<style>
  @layer components {
    /* One column as wide as the page: an `auto` track would grow to a wide table's width. */
    .entry-detail {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--flow-section);
      max-inline-size: var(--measure);
    }

    .entry-detail__header {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min-width)), 1fr));
      gap: var(--space-m);
      align-items: start;
    }

    .entry-detail__intro {
      display: grid;
      gap: var(--space-2xs);
    }

    .entry-detail__type {
      font-family: var(--badge-font);
      font-size: var(--text-small);
      font-weight: var(--font-weight-label);
      color: var(--badge-text);
      border: var(--badge-border);
      border-radius: var(--chip-radius);
      padding: 0 var(--space-2xs);
      text-decoration: none;
    }

    .entry-detail__summary {
      font-size: var(--entry-summary-size);
    }

    .lore {
      font-style: italic;
      color: var(--color-text-muted);
      border-inline-start: var(--border-width-strong) solid var(--color-border);
      padding-inline-start: var(--space-s);

      & > :global(* + *) {
        margin-block-start: var(--flow-text);
      }
    }

    .entry-detail__links {
      display: grid;
      gap: var(--space-2xs);
    }

    /* The disclosure is rendered by the shared component, outside this file's scope. */
    .entry-detail__links :global(.entry-detail__refs-label) {
      font-weight: var(--font-weight-strong);
    }

    /* Under the label's text, past the chevron. */
    .entry-detail__refs-list {
      padding-inline-start: calc(var(--disclosure-chevron) + var(--disclosure-gap));
    }

    .entry-detail__provenance {
      color: var(--color-text-muted);
    }
  }

</style>
