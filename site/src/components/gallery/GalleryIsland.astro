---
// Mounts the Library's gallery island (docs/site.md#pages-and-navigation, docs/site.md#gallery). The
// island fetches library.json once it runs; without JavaScript, a plain list of every entry links
// to its detail page instead.
import Gallery from './Gallery';
import registryJson from '../../../../config/types.json';
import { entryNames, entryPath, loadEntries } from '../../lib/library';
import { facetData } from '../../lib/gallery/facet-data';
import type { Registry } from '../../lib/gallery/config';
import { loadRules } from '../../lib/rules';
import { url } from '../../lib/url';

const rules = loadRules();
const all = loadEntries(rules);
// Ref targets' names and the groups a groups facet nests (docs/site.md#gallery "Filters").
const data = facetData(registryJson as unknown as Registry, all, entryNames(all, rules), rules);
const entries = [...all].sort((a, b) => a.entry.name.localeCompare(b.entry.name, 'en', { sensitivity: 'base' }));
---
<Gallery client:load indexUrl={url('library.json')} base={url()} facetData={data} />
<noscript>
  {entries.length === 0 ? (
    <p>No entries yet.</p>
  ) : (
    <ul>
      {entries.map(({ entry }) => (
        <li><a href={url(entryPath(entry))}>{entry.name}</a>: {entry.summary}</li>
      ))}
    </ul>
  )}
</noscript>
