---
// The top bar (docs/site.md#pages-and-navigation): Library, Rulesets, About, and Contribute,
// which links to the repository. The current section is marked for assistive technology: the
// Library on `/`, Rulesets on its page and every rules page. After the links, the print cart's
// count (docs/site.md#gallery "Cart and set actions"), which needs JavaScript, so it stays hidden
// until the script shows it.
import { REPO_URL } from '../../../lib/site.ts';
import { url } from '../lib/url';

const here = Astro.url.pathname;
const rulesPage = here.startsWith(url()) && /^[^/]+\/rules\//.test(here.slice(url().length));
type Current = 'page' | 'true' | undefined;
const links: { label: string; href: string; current: Current }[] = [
  { label: 'Library', href: url(), current: here === url() ? 'page' : undefined },
  { label: 'Rulesets', href: url('rulesets/'), current: here === url('rulesets/') ? 'page' : rulesPage ? 'true' : undefined },
  { label: 'About', href: url('about/'), current: here === url('about/') ? 'page' : undefined },
  { label: 'Contribute', href: REPO_URL, current: undefined },
];
---
<nav class="site-nav" aria-label="Site">
  <ul class="site-nav__list">
    {links.map((link) => (
      <li><a href={link.href} aria-current={link.current}>{link.label}</a></li>
    ))}
  </ul>
  <p class="site-nav__cart" data-cart-count hidden>Cart: <span>0</span></p>
</nav>

<script>
  import { onCartChange, readCart } from '../lib/cart.ts';

  for (const count of document.querySelectorAll<HTMLElement>('[data-cart-count]')) {
    const show = () => {
      const n = String(readCart().length);
      const value = count.querySelector('span');
      if (value && value.textContent !== n) value.textContent = n;
    };
    show();
    onCartChange(show);
    count.hidden = false;
  }
</script>

<style>
  @layer components {
    .site-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-s);
      font-family: var(--font-ui);
    }

    .site-nav__cart {
      color: var(--color-text-muted);
    }

    .site-nav__list {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-s);
      padding: 0;
      list-style: none;
    }

    .site-nav a[aria-current] {
      color: var(--color-text);
    }
  }
</style>
