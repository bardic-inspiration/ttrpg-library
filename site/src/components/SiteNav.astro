---
// The top bar (docs/site.md#pages-and-navigation): Library, Rulesets, About, and Contribute,
// which links to the repository. The current section is marked for assistive technology: the
// Library on `/`, Rulesets on its page and every rules page.
import { REPO_URL } from '../../../lib/site.ts';
import { url } from '../lib/url';

const here = Astro.url.pathname;
const rulesPage = here.startsWith(url()) && /^[^/]+\/rules\//.test(here.slice(url().length));
type Current = 'page' | 'true' | undefined;
const links: { label: string; href: string; current: Current }[] = [
  { label: 'Library', href: url(), current: here === url() ? 'page' : undefined },
  { label: 'Rulesets', href: url('rulesets/'), current: here === url('rulesets/') ? 'page' : rulesPage ? 'true' : undefined },
  { label: 'About', href: url('about/'), current: here === url('about/') ? 'page' : undefined },
  { label: 'Contribute', href: REPO_URL, current: undefined },
];
---
<nav class="site-nav" aria-label="Site">
  <ul class="site-nav__list">
    {links.map((link) => (
      <li><a href={link.href} aria-current={link.current}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  @layer components {
    .site-nav {
      font-family: var(--font-ui);
    }

    .site-nav__list {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-s);
      padding: 0;
      list-style: none;
    }

    .site-nav a[aria-current] {
      color: var(--color-text);
      text-decoration: none;
    }
  }
</style>
