---
// An arrangement's kit parts (docs/site.md#kit-parts, docs/content-model.md#arrangements), each in
// order by its shared component, under its heading, so every arrangement reads alike. A page that
// lists its parts in a summary passes each part's anchor.
import { partHeading, type KitContext } from '../../lib/kit';
import type { Part } from '../../../../rulesets/dnd-5e-2024/types.ts';
import Heading from '../templates/parts/Heading.astro';
import KitArrangement from './KitArrangement.astro';
import KitHook from './KitHook.astro';
import KitLoot from './KitLoot.astro';
import KitMap from './KitMap.astro';
import KitRoster from './KitRoster.astro';
import KitSequence from './KitSequence.astro';
import KitSpawnTable from './KitSpawnTable.astro';
import KitTable from './KitTable.astro';
import KitText from './KitText.astro';

interface Props {
  parts: Part[];
  kit: KitContext;
  /** Each part's anchor, by index; a part without one has none. */
  ids?: (string | undefined)[];
}

const { parts, kit, ids = [] } = Astro.props;
---
{parts.map((part, index) => {
  const heading = partHeading(part, kit.arrangement);
  return (
    <section class="kit-part" data-part={part.part} id={ids[index]}>
      {heading !== undefined && <Heading level={kit.level} class="statblock-heading">{heading}</Heading>}
      {part.part === 'prose' || part.part === 'dm-guide' ? (
        <KitText text={part.text} kit={kit} />
      ) : part.part === 'description' ? (
        <KitText text={part.text} readAloud kit={kit} />
      ) : part.part === 'roster' ? (
        <KitRoster creatures={part.creatures} kit={kit} />
      ) : part.part === 'spawn-table' ? (
        <KitSpawnTable roll={part.roll} rows={part.rows} kit={kit} />
      ) : part.part === 'sequence' ? (
        <KitSequence sequence={part} kit={kit} />
      ) : part.part === 'table' ? (
        <KitTable title={part.title} text={part.text} kit={kit} />
      ) : part.part === 'loot' ? (
        <KitLoot rows={part.rows} kit={kit} />
      ) : part.part === 'hook' ? (
        <KitHook text={part.text} refs={part.refs} kit={kit} />
      ) : part.part === 'arrangement' ? (
        <KitArrangement arrangement={part.arrangement} kit={kit} />
      ) : (
        <KitMap map={part.map} kit={kit} />
      )}
    </section>
  );
})}

<style>
  @layer components {
    .kit-part > :global(* + *) {
      margin-block-start: var(--space-2xs);
    }

    .kit-part > :global(.statblock-heading) {
      break-after: avoid;
    }

    :global(.kit-list) {
      display: grid;
      gap: var(--space-3xs);
      padding: 0;
      list-style: none;
    }
  }
</style>
