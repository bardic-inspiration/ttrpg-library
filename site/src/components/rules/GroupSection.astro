---
// A group's section on its rules page (docs/site.md#rules-pages): its anchored heading with its
// note, its opening text, its members (a leaf group) or the groups nested in
// it, and its links. A union group lists its members as links instead.
import { anchorId, ruleKey, sortMembers, type GroupTree } from '../../../../lib/rules';
import { renderMarkdown } from '../../lib/markdown';
import type { RulesContext } from '../../lib/rules';
import { url } from '../../lib/url';
import Heading from '../templates/parts/Heading.astro';
import PrimitiveSection from './PrimitiveSection.astro';
import RefLinks from './RefLinks.astro';

interface Props {
  ctx: RulesContext;
  tree: GroupTree;
  id: string;
  level: number;
}

const { ctx, tree, id, level } = Astro.props;
const group = tree.byId.get(id)!;
const key = ruleKey({ type: tree.type, id });
const refs = { names: ctx.names, ruleset: ctx.data.ruleset, paths: ctx.paths };
const primitives = ctx.data.primitives.filter((p) => p.type === tree.type);
const children = tree.children(id);
const members = tree.isLeaf(id) ? sortMembers(group, tree.membersOf(id, primitives), ctx.derive) : [];
const unionMembers = group.union ? tree.allMembers(id, primitives) : [];
---
<section class="rule-group" id={anchorId(key)} data-type={tree.type}>
  <Heading level={level}>{group.name}{group.note && <span class="rule-group__note"> ({group.note})</span>}</Heading>
  {group.text && <div class="rule-group__text" set:html={renderMarkdown(group.text, refs)} />}
  <RefLinks ctx={ctx} key={key} />
  {unionMembers.length > 0 && (
    <ul class="rule-group__union">
      {unionMembers.map((p) => <li><a href={url(ctx.paths.get(ruleKey(p)) ?? '')}>{p.name}</a></li>)}
    </ul>
  )}
  {members.map((primitive) => <PrimitiveSection ctx={ctx} primitive={primitive} level={level + 1} />)}
  {children.map((child) => <Astro.self ctx={ctx} tree={tree} id={child.id} level={level + 1} />)}
</section>

<style>
  @layer components {
    .rule-group {
      display: grid;
      gap: var(--space-s);
    }

    .rule-group__note {
      font-weight: normal;
    }
  }
</style>
