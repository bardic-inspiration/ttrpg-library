---
// SRD chapter text on a rules page that isn't a primitive (docs/site.md#rules-pages), with its
// nested sections a level down. A titled section at the top of the page is an accordion section
// (docs/site.md#accordion-pages), anchored at `section-<title>`; the sections nested in it show
// when it opens.
import type { ProseSection as Prose } from '../../../../lib/rules';
import { sectionId } from '../../lib/accordion';
import { renderMarkdown } from '../../lib/markdown';
import type { RulesContext } from '../../lib/rules';
import Accordion from '../templates/parts/Accordion.astro';
import Heading from '../templates/parts/Heading.astro';

interface Props {
  ctx: RulesContext;
  /** A page's opening prose may have no title. */
  section: Omit<Prose, 'title'> & { title?: string };
  level: number;
  /** The section is one of the page's own, so a titled one collapses. */
  top?: boolean;
}

const { ctx, section, level, top = false } = Astro.props;
const refs = { names: ctx.names, ruleset: ctx.data.ruleset, paths: ctx.paths };
---
{top && section.title ? (
  <Accordion class="rule-prose" id={sectionId(section.title)} level={level}>
    <Fragment slot="title">{section.title}</Fragment>
    {section.text && <div set:html={renderMarkdown(section.text, refs)} />}
    {(section.sections ?? []).map((inner) => <Astro.self ctx={ctx} section={inner} level={level + 1} />)}
  </Accordion>
) : (
  <section class="rule-prose">
    {section.title && <Heading level={level}>{section.title}</Heading>}
    {section.text && <div set:html={renderMarkdown(section.text, refs)} />}
    {(section.sections ?? []).map((inner) => <Astro.self ctx={ctx} section={inner} level={level + 1} />)}
  </section>
)}
