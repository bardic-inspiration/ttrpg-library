---
// The old Rulesets page (docs/site.md#redirects): it redirects to the home ruleset's Library, whose
// menu lists the ruleset's rules pages (docs/site.md#gallery "Layout").
import Base from '../layouts/Base.astro';
import { homeRuleset, libraryPath } from '../lib/gallery/library-url';
import type { Registry } from '../lib/gallery/config';
import { url } from '../lib/url';
import registryJson from '@library/config/types.json';

const registry = registryJson as unknown as Registry;
const moved = url(libraryPath(homeRuleset(registry)));
---
<Base title="Rules · TTRPG Content Library" redirect={moved}>
  <p>Each ruleset's rules pages are listed in its Library: <a href={moved}>{registry[homeRuleset(registry)]?.label} Library</a>.</p>
</Base>
