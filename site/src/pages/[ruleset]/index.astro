---
// A ruleset's Library (docs/site.md#pages-and-navigation, docs/site.md#gallery): one gallery of
// the ruleset's entries, whose filters do the navigating. One page per registered ruleset.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import GalleryIsland from '../../components/gallery/GalleryIsland.astro';
import registry from '@library/config/types.json';

export const getStaticPaths = (() =>
  Object.entries(registry).map(([ruleset, config]) => ({ params: { ruleset }, props: { label: config.label } }))) satisfies GetStaticPaths;

const { ruleset } = Astro.params;
const { label } = Astro.props;
---
<Base title={`${label} Library · TTRPG Content Library`}>
  <h1>{label} Library</h1>
  <GalleryIsland ruleset={ruleset} />
</Base>
