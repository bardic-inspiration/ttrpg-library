---
// Detail page for one entry (SPEC.md §9.2). The full detail layout arrives in
// milestone 3 (#12); this shows the entry, with its forward refs and
// back-refs (§5.7), so a content merge visibly changes the live site.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import CreatureStatBlock from '../../../components/templates/CreatureStatBlock.astro';
import { entryPath, loadEntries, rulesetModule, type LoadedEntry } from '../../../lib/library';
import { groupRefs, type RefTarget } from '../../../lib/refs';
import { url } from '../../../lib/url';
import type { CreatureStats, DerivedCreature } from '../../../../../rulesets/dnd-5e-2024/types.ts';

export const getStaticPaths = (() => {
  const all = loadEntries();
  const names = new Map(all.map(({ entry }) => [`${entry.type}/${entry.id}`, entry.name]));
  const targets = new Map<string, RefTarget>(
    all.map(({ entry }) => [`${entry.type}/${entry.id}`, { type: entry.type, name: entry.name, path: entryPath(entry) }]),
  );
  return all.map((loaded) => ({
    params: { ruleset: loaded.entry.ruleset, type: loaded.entry.type, id: loaded.entry.id },
    props: { loaded, names, targets },
  }));
}) satisfies GetStaticPaths;

interface Props {
  loaded: LoadedEntry;
  names: Map<string, string>;
  targets: Map<string, RefTarget>;
}

const { loaded, names, targets } = Astro.props;
const { entry, derived } = loaded;
const module = rulesetModule(entry.ruleset);
const links = groupRefs(entry.type, loaded.refs, loaded.refBy, targets, (type, path) => module.refLabels(type, path));
const linkGroups = [...links.forward, ...links.back];
---
<Base title={`${entry.name} · TTRPG Content Library`}>
  <article>
    <h1>{entry.name}</h1>
    <p>{entry.summary}</p>
    {entry.description && <p>{entry.description}</p>}
    {entry.ruleset === 'dnd-5e-2024' && entry.type === 'creature' && (
      <CreatureStatBlock
        name={entry.name}
        stats={entry.stats as CreatureStats}
        derived={derived as unknown as DerivedCreature}
        names={names}
      />
    )}
    {linkGroups.length > 0 && (
      <section aria-labelledby="links-heading">
        <h2 id="links-heading">Links</h2>
        <dl>
          {linkGroups.map((group) => (
            <>
              <dt>{group.label}</dt>
              <dd>
                {group.targets.map((target, i) => (
                  <>{i > 0 && ', '}<a href={url(target.path)}>{target.name}</a></>
                ))}
              </dd>
            </>
          ))}
        </dl>
      </section>
    )}
    <p>
      <small>Added {entry.meta.createdAt}{entry.meta.updatedAt && `, revised ${entry.meta.updatedAt}`}.</small>
    </p>
  </article>
</Base>
