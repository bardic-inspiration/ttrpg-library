---
// Detail page for one entry (SPEC.md §9.2, §9.4), with Open Graph tags from
// the entry's name, summary, and art, its export controls, and the PNG
// exporter's capture source (§10).
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import CaptureSource from '../../../components/detail/CaptureSource.astro';
import EntryDetail from '../../../components/detail/EntryDetail.astro';
import ExportControls from '../../../components/detail/ExportControls';
import { entryNames, loadEntries, refTargets, type LoadedEntry } from '../../../lib/library';
import type { RefTarget } from '../../../lib/refs';
import { url } from '../../../lib/url';

export const getStaticPaths = (() => {
  const all = loadEntries();
  const names = entryNames(all);
  const targets = refTargets(all);
  return all.map((loaded) => ({
    params: { ruleset: loaded.entry.ruleset, type: loaded.entry.type, id: loaded.entry.id },
    props: { loaded, names, targets },
  }));
}) satisfies GetStaticPaths;

interface Props {
  loaded: LoadedEntry;
  names: Map<string, string>;
  targets: Map<string, RefTarget>;
}

const { loaded, names, targets } = Astro.props;
const { entry, derived } = loaded;
---
<Base
  title={`${entry.name} · TTRPG Content Library`}
  og={{ title: entry.name, description: entry.summary, image: entry.image ? url(entry.image) : undefined, type: 'article' }}
>
  <EntryDetail loaded={loaded} names={names} targets={targets}>
    <ExportControls slot="export" client:load item={{ entry, derived }} base={url()} />
  </EntryDetail>
  <CaptureSource loaded={loaded} names={names} />
</Base>
