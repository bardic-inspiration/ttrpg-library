---
// A type's old gallery (docs/site.md#redirects): it redirects to the Library with the ruleset
// and type filters set and the type's default sort. One page per registered type, and one per
// former key of a renamed type, which sets the current type.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { formerTypes } from '../../../lib/redirects';
import { libraryQuery } from '../../../lib/gallery/library-url';
import type { Registry } from '../../../lib/gallery/config';
import { url } from '../../../lib/url';
import registryJson from '../../../../../config/types.json';

export const getStaticPaths = (() => {
  const registry = registryJson as unknown as Registry;
  const page = (ruleset: string, path: string, type: string) => ({
    params: { ruleset, type: path },
    props: {
      plural: registry[ruleset]!.types[type]!.plural,
      rulesetLabel: registry[ruleset]!.label,
      moved: `${url()}${libraryQuery(registry, ruleset, type)}`,
    },
  });
  return [
    ...Object.entries(registry).flatMap(([ruleset, config]) => Object.keys(config.types).map((type) => page(ruleset, type, type))),
    ...formerTypes(registry).map((former) => page(former.ruleset, former.from, former.to)),
  ];
}) satisfies GetStaticPaths;

const { plural, rulesetLabel, moved } = Astro.props;
---
<Base title={`${plural} · ${rulesetLabel} · TTRPG Content Library`} redirect={moved}>
  <p>{plural} are in the <a href={moved}>Library</a>.</p>
</Base>
