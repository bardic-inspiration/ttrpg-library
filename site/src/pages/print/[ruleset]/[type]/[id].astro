---
// An entry's print fragment (docs/export.md#print): bare markup, with no page shell,
// that the print view (`/print/`) fetches and inserts. Served at
// `print/<ruleset>/<type>/<id>/`, so a print run loads only the entries it
// names. The print view's page carries the styles.
import type { GetStaticPaths } from 'astro';
import PrintEntry from '../../../../components/print/PrintEntry.astro';
import { entryNames, loadEntries, refPaths, type LoadedEntry } from '../../../../lib/library';
import { loadRules } from '../../../../lib/rules';

export const partial = true;

export const getStaticPaths = (() => {
  const rules = loadRules();
  const all = loadEntries(rules);
  const names = entryNames(all, rules);
  const paths = refPaths(rules);
  return all.map((loaded) => ({
    params: { ruleset: loaded.entry.ruleset, type: loaded.entry.type, id: loaded.entry.id },
    props: { loaded, names, paths },
  }));
}) satisfies GetStaticPaths;

interface Props {
  loaded: LoadedEntry;
  names: Map<string, string>;
  paths: Map<string, string>;
}

const { loaded, names, paths } = Astro.props;
---
<PrintEntry loaded={loaded} names={names} paths={paths} />
