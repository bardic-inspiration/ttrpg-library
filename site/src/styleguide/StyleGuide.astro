---
// The style guide (docs/styling.md#refinement-workflow): every token, the type scale and typefaces,
// controls, badges, and templates, in the site's one palette. Not linked
// in navigation and kept out of search indexes. Edit a token under
// `npm run dev` and every surface here updates at once.
//
// Gallery cards, filter controls, and templates come from the example test
// fixtures (docs/styling.md#refinement-workflow), and the export controls show Download's menu
// closed and open (docs/export.md#controls).
import Base from '../layouts/Base.astro';
import EntryTemplate from '../components/templates/EntryTemplate.astro';
import PrintEntry from '../components/print/PrintEntry.astro';

// The two print layouts (docs/export.md#print-layout), each previewed at a
// sample page's width inside its margin from tokens/print.css.
const printLayouts = [
  { id: 'wide', label: 'Wide page: US Letter', width: 'calc(8.5in - 2 * 0.5in)' },
  { id: 'narrow', label: 'Narrow page: 4 × 6 in card', width: 'calc(4in - 2 * 0.3in)' },
];
import SearchIcon from '../icons/Search';
import FilterIcon from '../icons/Filter';
import SortIcon from '../icons/Sort';
import DownloadIcon from '../icons/Download';
import PrintIcon from '../icons/Print';
import ExportButtons from '../components/export/ExportButtons';
import { configuredControls } from '../exporters/index';
import Card from '../components/gallery/Card';
import { FilterTree } from '../components/gallery/Filters';
import '../components/gallery/gallery.css';
import sampleArt from '../assets/sample-art.svg';
import { galleryConfig, type Registry } from '../lib/gallery/config';
import { parseQuery } from '../lib/gallery/state';
import { filterTree } from '../lib/gallery/tree';
import registryJson from '../../../config/types.json';
import { buildIndex } from '../../../scripts/build-index/index.ts';
import { PROJECT_ROOT } from '../../../scripts/validate/schema.ts';
import { readTokens, resolveToken, tokensIn, type TokenDecl } from '../lib/design-tokens';
import { entryNames as namesOf, loadLibrary, type Entry } from '../lib/library';
import { readFileSync } from 'node:fs';
import primitivesCss from '../styles/tokens/primitives.css?raw';
import semanticCss from '../styles/tokens/semantic.css?raw';
import componentsCss from '../styles/tokens/components.css?raw';
import contentCss from '../styles/tokens/content.css?raw';

const semantic = readTokens(semanticCss);
const content = readTokens(contentCss);
const components = readTokens(componentsCss);
const all: TokenDecl[] = [...readTokens(primitivesCss), ...semantic, ...content, ...components];
const palette = tokensIn(all, 'base');
const names = (decls: TokenDecl[], test: RegExp) =>
  [...new Set(decls.filter((d) => d.scope !== 'other' && test.test(d.name)).map((d) => d.name))];

const colorTokens = names(semantic, /^--color-/);
const contentTokens = names(content, /^--(accent|rarity)-/);
const fontTokens = names(semantic, /^--font-(heading|body|ui)$/);
const textTokens = names(semantic, /^--text-/);
// The two heading ladders (docs/styling.md#type-and-headings).
const pageLadder = [1, 2, 3, 4, 5, 6].map((n) => ({ label: `h${n}`, token: `--text-h${n}` }));
const statblockLadder = [
  { label: 'Stat block name', token: '--text-statblock-name' },
  { label: 'Stat block section', token: '--text-statblock-heading' },
  { label: 'Nested section', token: '--text-statblock-subheading' },
  { label: 'Gallery card title', token: '--text-card-title' },
];
const spaceTokens = names(semantic, /^--space-/);
const flowTokens = names(semantic, /^--flow-/);
const radiusTokens = names(semantic, /^--radius-/);
const shadowTokens = names(semantic, /^--shadow-/);
const durationTokens = names(semantic, /^--duration-/);
const componentTokens = [...tokensIn(components, 'base').entries()];

const types = contentTokens.filter((n) => n.startsWith('--accent-')).map((n) => n.replace('--accent-', ''));
const rarities = contentTokens.filter((n) => n.startsWith('--rarity-')).map((n) => n.replace('--rarity-', ''));
const label = (slug: string) => slug.replace(/-/g, ' ');

const icons = [
  ['Search', SearchIcon], ['Filter', FilterIcon], ['Sort', SortIcon],
  ['Download', DownloadIcon], ['Print', PrintIcon],
] as const;

// Cards, filters, and templates render the example fixtures, which have one entry per type.
const fixtures = await buildIndex(`${PROJECT_ROOT}/tests/fixtures/library/valid`);
const fixtureEntries = loadLibrary(
  fixtures.files.map((file) => JSON.parse(readFileSync(`${PROJECT_ROOT}/tests/fixtures/library/valid/${file}`, 'utf8')) as Entry),
);
const entryNames = namesOf(fixtureEntries);
const registry = registryJson as unknown as Registry;
const home = galleryConfig(registry);
// The filter tree as the Library opens it, and with filters set, which opens the nodes holding them.
const treeAt = (query: string) => {
  const state = parseQuery(query, home);
  return { nodes: filterTree(home, state, fixtures.records), filters: state.filters };
};
const filterStates = [
  { title: 'As the Library opens it', ...treeAt('') },
  { title: 'With a type and a facet value set', ...treeAt('?f.type=spell&f.stats.school=evocation') },
  { title: 'With a type checked, its default filters open, and a range set', ...treeAt('?f.type=creature&f.stats.cr=1/4..2') },
];
const noop = () => {};
const cardInfo = (r: (typeof fixtures.records)[number]) => home.types.get(`${r.ruleset}/${r.type}`)!;

const modes = ['screen', 'capture'] as const;
---
<Base title="Style guide · TTRPG Content Library" noindex>
  <h1>Style guide</h1>
  <p class="measure">
    Every token and rendered state on one page. To change what you see, edit <code>site/src/styles/tokens/</code> (docs/styling.md#refinement-workflow).
  </p>

  <section class="sg-section" aria-labelledby="sg-colors">
    <h2 id="sg-colors">Colors</h2>
    <h3>Semantic</h3>
    <ul class="sg-swatches">
      {colorTokens.map((name) => (
        <li class="sg-swatch">
          <span class="sg-swatch__chip" style={`background: var(${name})`}></span>
          <code>{name}</code>
          <small>{resolveToken(palette, name)}</small>
        </li>
      ))}
    </ul>
    <h3>Types and rarities</h3>
    <ul class="sg-swatches">
      {contentTokens.map((name) => (
        <li class="sg-swatch">
          <span class="sg-swatch__chip" style={`background: var(${name})`}></span>
          <code>{name}</code>
          <small>{resolveToken(palette, name)}</small>
        </li>
      ))}
    </ul>
  </section>

  <section class="sg-section" aria-labelledby="sg-type">
    <h2 id="sg-type">Typography</h2>
    <h3>Typefaces</h3>
    <ul class="sg-list">
      {fontTokens.map((name) => (
        <li><p class="sg-sample" style={`font-family: var(${name})`}>The ember hound bays at the cold stars.</p><code>{name}</code></li>
      ))}
      <li><p class="sg-sample sg-sample--italic">Italic lore text, as in a description.</p><code>--font-body, italic</code></li>
    </ul>
    <h3>Type scale</h3>
    <ul class="sg-list">
      {textTokens.map((name) => (
        <li><p class="sg-sample" style={`font-size: var(${name})`}>Cinder Hound</p><code>{name}</code></li>
      ))}
    </ul>
  </section>

  <section class="sg-section" aria-labelledby="sg-standards">
    <h2 id="sg-standards">Standards</h2>
    <p class="measure">The rules in docs/styling.md#standards, as the tokens render them.</p>
    <h3>Page headings: size follows level</h3>
    <ul class="sg-list">
      {pageLadder.map(({ label: name, token }) => (
        <li><p class="sg-heading" style={`font-size: var(${token})`}>{name} Cinder Hound</p><code>{token}</code></li>
      ))}
    </ul>
    <h3>Stat block headings: size follows role</h3>
    <ul class="sg-list">
      {statblockLadder.map(({ label: name, token }) => (
        <li><p class="sg-heading sg-heading--statblock" style={`font-size: var(${token})`}>{name}</p><code>{token}</code></li>
      ))}
    </ul>
    <h3>Spacing roles</h3>
    <ul class="sg-list">
      {flowTokens.map((name) => (
        <li><span class="sg-bar" style={`inline-size: var(${name})`}></span><code>{name}</code> <small>{resolveToken(palette, name)}</small></li>
      ))}
    </ul>
    <h3>Links</h3>
    <ul class="sg-list">
      <li><p>Rules text: the target has the <a href="#sg-standards">Grappled</a> condition.</p><code>underlined</code></li>
      <li><nav aria-label="Quiet link sample"><a href="#sg-standards">Navigation, heading, or link list</a></nav><code>quiet</code></li>
      <li><nav aria-label="Hovered link sample" class="sg-link-hover"><a href="#sg-standards">The same, hovered or focused</a></nav><code>quiet :hover, :focus-visible</code></li>
      <li><nav aria-label="Current link sample"><a href="#sg-standards" aria-current="page">The current page in the nav</a></nav><code>[aria-current]</code></li>
    </ul>
  </section>

  <section class="sg-section" aria-labelledby="sg-scales">
    <h2 id="sg-scales">Spacing, radii, shadows, durations</h2>
    <ul class="sg-list">
      {spaceTokens.map((name) => (
        <li><span class="sg-bar" style={`inline-size: var(${name})`}></span><code>{name}</code> <small>{resolveToken(palette, name)}</small></li>
      ))}
    </ul>
    <ul class="sg-swatches">
      {radiusTokens.map((name) => (
        <li class="sg-swatch"><span class="sg-swatch__chip sg-swatch__chip--outline" style={`border-radius: var(${name})`}></span><code>{name}</code></li>
      ))}
      {shadowTokens.map((name) => (
        <li class="sg-swatch"><span class="sg-swatch__chip sg-swatch__chip--surface" style={`box-shadow: var(${name})`}></span><code>{name}</code></li>
      ))}
    </ul>
    <ul class="sg-list">
      {durationTokens.map((name) => (
        <li><code>{name}</code> <small>{resolveToken(palette, name)} (0ms with reduced motion)</small></li>
      ))}
    </ul>
  </section>

  <section class="sg-section" aria-labelledby="sg-components">
    <h2 id="sg-components">Component tokens</h2>
    <table class="sg-table">
      <thead><tr><th scope="col">Token</th><th scope="col">Defaults to</th></tr></thead>
      <tbody>
        {componentTokens.map(([name, value]) => <tr><td><code>{name}</code></td><td><code>{value}</code></td></tr>)}
      </tbody>
    </table>
  </section>

  <section class="sg-section" aria-labelledby="sg-samples">
    <h2 id="sg-samples">Samples</h2>
    <div class="sg-samples">
      <p>Body text with a <a href="#sg-samples">link</a> and <span class="sg-muted">muted text</span>.</p>

      <h3>Controls</h3>
      <div class="cluster">
        <button type="button">Button</button>
        <button type="button" class="sg-focused">Focused</button>
      </div>
      <div class="cluster">
        <label>Search <input type="search" placeholder="Name" /></label>
        <label><input type="checkbox" checked /> Selected</label>
      </div>

      <h3>Export controls</h3>
      <div class="cluster sg-exports">
        <ExportButtons controls={configuredControls('entry')} run={noop} menuId="sg-formats-closed" />
        <ExportButtons controls={configuredControls('entry')} run={noop} menuId="sg-formats-open" open />
      </div>

      <h3>Icons</h3>
      <ul class="cluster sg-row sg-icons">
        {icons.map(([name, IconComponent]) => <li><IconComponent /><small>{name}</small></li>)}
      </ul>

      <h3>Type and rarity badges</h3>
      <ul class="cluster sg-row">
        {types.map((type) => <li class="sg-badge" data-type={type}>{label(type)}</li>)}
      </ul>
      <ul class="cluster sg-row">
        {rarities.map((rarity) => <li class="sg-badge" data-rarity={rarity}>{label(rarity)}</li>)}
      </ul>

      <h3>Gallery cards</h3>
      <ul class="sg-cards">
        {fixtures.records.map((record, i) => (
          <li>
            <Card
              record={record}
              typeLabel={cardInfo(record).label}
              cardFields={cardInfo(record).cardFields}
              imageSrc={i === 0 ? sampleArt.src : undefined}
              selected={i === 1}
              onSelect={noop}
            />
          </li>
        ))}
      </ul>

      <h3>Filter controls</h3>
      <div class="sg-filters">
        {filterStates.map(({ title, nodes, filters }) => (
          <>
            <h4>{title}</h4>
            <FilterTree nodes={nodes} filters={filters} onEnum={noop} onRange={noop} />
          </>
        ))}
      </div>

      {fixtureEntries.map(({ entry, derived }) =>
        modes.map((mode) => (
          <>
            <h3>{entry.name}: {mode}</h3>
            <EntryTemplate entry={entry} derived={derived} names={entryNames} mode={mode} level={4} />
          </>
        )),
      )}
    </div>
  </section>

  <section class="sg-section" aria-labelledby="sg-print">
    <h2 id="sg-print">Print previews</h2>
    <p class="measure">
      Each template in <code>print</code> mode in each print layout, at a
      sample page's width inside its margins. The layout follows the printed
      page's width; density, margins, and the breakpoint are in
      <code>tokens/print.css</code>.
    </p>
    {printLayouts.map((layout) => (
      <>
        <h3>{layout.label}</h3>
        <div class="sg-print-row">
          {fixtureEntries.map((loaded) => (
            <div
              class="sg-print"
              data-print-layout={layout.id}
              style={`inline-size: ${layout.width}`}
            >
              <PrintEntry loaded={loaded} names={entryNames} level={4} />
            </div>
          ))}
        </div>
      </>
    ))}
  </section>
</Base>

<style>
  @layer components {
    .sg-print-row {
      display: flex;
      flex-wrap: wrap;
      align-items: start;
      gap: var(--space-m);
      overflow-x: auto;
    }

    .sg-print {
      flex: none;
      max-inline-size: 100%;
      background: var(--color-bg);
      color: var(--color-text);
      border: var(--border-width) solid var(--color-border);
      padding: var(--space-s);
    }

    .sg-heading {
      font-family: var(--font-heading);
      font-weight: var(--font-weight-label);
      line-height: var(--leading-heading);
    }

    .sg-heading--statblock {
      font-family: var(--statblock-heading-font);
      color: var(--color-accent);
    }

    .sg-link-hover a {
      color: var(--link-hover-color);
      text-decoration-line: underline;
    }

    .sg-section {
      display: grid;
      gap: var(--space-s);
      padding-block-start: var(--space-l);
    }

    .sg-swatches {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--card-min-width)), 1fr));
      gap: var(--space-s);
      padding: 0;
      list-style: none;
    }

    .sg-swatch {
      display: grid;
      gap: var(--space-3xs);
      font-family: var(--font-ui);

      & small {
        color: var(--color-text-muted);
      }
    }

    .sg-swatch__chip {
      display: block;
      block-size: var(--space-xl);
      border: var(--border-width) solid var(--color-control-border);
      border-radius: var(--radius-control);
    }

    .sg-swatch__chip--outline {
      background: var(--color-surface);
    }

    .sg-swatch__chip--surface {
      background: var(--color-surface);
      border-color: var(--color-border);
    }

    .sg-list {
      display: grid;
      gap: var(--space-xs);
      padding: 0;
      list-style: none;
    }

    .sg-sample {
      line-height: var(--leading-heading);
    }

    .sg-sample--italic {
      font-style: italic;
    }

    .sg-bar {
      display: inline-block;
      block-size: var(--space-s);
      background: var(--color-accent);
      vertical-align: middle;
      margin-inline-end: var(--space-2xs);
    }

    .sg-table {
      font-family: var(--font-ui);
      font-size: var(--text-small);
      display: block;
      overflow-x: auto;

      & th,
      & td {
        text-align: start;
        padding: var(--space-3xs) var(--space-2xs);
        border-block-end: var(--border-width) solid var(--color-border);
      }
    }

    .sg-samples {
      display: grid;
      align-content: start;
      gap: var(--space-s);
      padding: var(--card-padding);
      border: var(--border-width) solid var(--card-border-color);
      border-radius: var(--card-radius);
    }

    .sg-muted {
      color: var(--color-text-muted);
    }

    .sg-focused {
      outline: var(--focus-ring);
      outline-offset: var(--focus-ring-offset);
    }

    .sg-icons {
      padding: 0;
      list-style: none;

      & li {
        display: grid;
        justify-items: center;
        gap: var(--space-3xs);
      }
    }

    .sg-badge {
      list-style: none;
      font-family: var(--badge-font);
      font-size: var(--text-small);
      font-weight: var(--font-weight-label);
      text-transform: capitalize;
      color: var(--badge-text);
      border: var(--badge-border);
      border-radius: var(--chip-radius);
      padding: 0 var(--space-2xs);
    }

    .sg-row {
      padding: 0;
    }

    /* Room for the open Download menu, which sits below its button. */
    .sg-exports {
      align-items: start;
      padding-block-end: var(--space-2xl);
    }

    .sg-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--card-min-width)), 1fr));
      gap: var(--grid-gap);
      padding: 0;
      list-style: none;
    }

    .sg-filters {
      display: grid;
      gap: var(--filters-gap);
      max-inline-size: var(--filters-width);
    }

  }
</style>
