---
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href={url()}>TTRPG Content Library</a>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
