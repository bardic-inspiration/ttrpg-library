{
  "name": "ttrpg-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "validate": "tsx scripts/validate/cli.ts",
    "build:index": "tsx scripts/build-index/cli.ts",
    "build": "npm run build:index && astro build --root site",
    "dev": "astro dev --root site",
    "check": "tsc --noEmit && astro check --root site && stylelint \"site/src/**/*.{css,astro}\"",
    "test": "vitest run",
    "a11y": "tsx scripts/a11y/cli.ts",
    "snapshots": "tsx scripts/snapshots/cli.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.4",
    "html-to-image": "^1.11.13",
    "marked": "^18.1.2",
    "minisearch": "^7.2.0",
    "postcss": "^8.5.32",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
