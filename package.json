{
  "name": "ttrpg-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "validate": "tsx scripts/validate/cli.ts",
    "build:index": "tsx scripts/build-index.ts",
    "build": "npm run build:index && astro build --root site",
    "dev": "astro dev --root site",
    "check": "tsc --noEmit && astro check --root site",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.4",
    "marked": "^18.1.2",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
