{
  "dnd-5e-2024": {
    "label": "D&D 5e (SRD 5.2)",
    "attribution": "srd-5.2",
    "types": {
      "background": {
        "label": "Background",
        "plural": "Backgrounds",
        "template": "background-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/background.md",
        "facets": [
          { "path": "stats.abilities", "label": "Ability scores", "kind": "enum", "format": "ability" },
          { "path": "stats.skills", "label": "Skills", "kind": "enum", "format": "title" }
        ],
        "cardFields": ["stats.abilities"],
        "defaultSort": "name:asc",
        "defaultFilters": ["stats.abilities", "tags.theme"]
      },
      "condition": {
        "label": "Condition",
        "plural": "Conditions",
        "template": "condition-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/condition.md",
        "facets": [],
        "cardFields": [],
        "defaultSort": "name:asc",
        "defaultFilters": ["tags.theme"]
      },
      "creature": {
        "label": "Creature",
        "plural": "Creatures",
        "template": "creature-stat-block",
        "guideline": "rulesets/dnd-5e-2024/guidelines/creature.md",
        "facets": [
          { "path": "stats.cr", "label": "CR", "kind": "range", "format": "cr" },
          {
            "path": "stats.size",
            "label": "Size",
            "kind": "enum",
            "format": "title",
            "order": ["tiny", "small", "medium", "large", "huge", "gargantuan"]
          },
          { "path": "stats.creatureType", "label": "Creature type", "kind": "enum", "format": "title" },
          { "path": "stats.abilities.str", "label": "STR", "kind": "range" },
          { "path": "stats.abilities.dex", "label": "DEX", "kind": "range" },
          { "path": "stats.abilities.con", "label": "CON", "kind": "range" },
          { "path": "stats.abilities.int", "label": "INT", "kind": "range" },
          { "path": "stats.abilities.wis", "label": "WIS", "kind": "range" },
          { "path": "stats.abilities.cha", "label": "CHA", "kind": "range" },
          { "path": "stats.ac.value", "label": "AC", "kind": "range" },
          { "path": "derived.hp.average", "label": "HP", "kind": "range" },
          { "path": "derived.xp", "label": "XP", "kind": "range" }
        ],
        "cardFields": ["stats.cr", "stats.size", "stats.creatureType"],
        "defaultSort": "stats.cr:asc",
        "defaultFilters": ["stats.cr", "stats.creatureType", "tags.theme"],
        "summaryField": "stats.cr",
        "gapBuckets": [{ "path": "stats.cr", "bins": [[0, 1], [2, 4], [5, 10], [11, 16], [17, 30]] }]
      },
      "equipment": {
        "label": "Equipment",
        "plural": "Equipment",
        "template": "equipment-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/equipment.md",
        "facets": [
          { "path": "derived.category", "label": "Category", "kind": "enum", "format": "title" },
          { "path": "stats.group", "label": "Group", "kind": "enum", "format": "title" },
          { "path": "derived.costGp", "label": "Cost (GP)", "kind": "range" },
          { "path": "stats.weapon.damage.type", "label": "Damage type", "kind": "enum", "format": "title" }
        ],
        "cardFields": ["stats.group", "derived.costGp"],
        "defaultSort": "derived.costGp:asc",
        "defaultFilters": ["derived.category", "tags.theme"]
      },
      "feat": {
        "label": "Feat",
        "plural": "Feats",
        "template": "feat-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/feat.md",
        "facets": [
          {
            "path": "stats.category",
            "label": "Category",
            "kind": "enum",
            "format": "title",
            "order": ["origin", "general", "fighting-style", "epic-boon"]
          },
          { "path": "stats.level", "label": "Prerequisite level", "kind": "range" },
          { "path": "derived.repeatable", "label": "Repeatable", "kind": "enum" }
        ],
        "cardFields": ["stats.category", "stats.level"],
        "defaultSort": "stats.category:asc",
        "defaultFilters": ["stats.category", "tags.theme"],
        "summaryField": "stats.category",
        "gapBuckets": [{ "path": "stats.category", "enum": ["origin", "general", "fighting-style", "epic-boon"] }]
      },
      "item": {
        "label": "Item",
        "formerly": ["magic-item"],
        "plural": "Items",
        "template": "item-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/item.md",
        "facets": [
          {
            "path": "stats.rarity",
            "label": "Rarity",
            "kind": "enum",
            "format": "rarity",
            "order": ["common", "uncommon", "rare", "very-rare", "legendary", "artifact", "varies"]
          },
          { "path": "stats.category", "label": "Category", "kind": "enum", "format": "title" },
          { "path": "stats.attunement.required", "label": "Attunement", "kind": "enum" },
          { "path": "stats.cursed", "label": "Cursed", "kind": "enum" }
        ],
        "cardFields": ["stats.rarity", "stats.category", "stats.attunement.required"],
        "defaultSort": "stats.rarity:asc",
        "defaultFilters": ["stats.rarity", "stats.category", "tags.theme"],
        "summaryField": "stats.rarity",
        "gapBuckets": [{ "path": "stats.rarity", "enum": ["common", "uncommon", "rare", "very-rare", "legendary"] }]
      },
      "spell": {
        "label": "Spell",
        "plural": "Spells",
        "template": "spell-card",
        "guideline": "rulesets/dnd-5e-2024/guidelines/spell.md",
        "facets": [
          { "path": "stats.level", "label": "Level", "kind": "range", "format": "spell-level" },
          { "path": "stats.school", "label": "School", "kind": "enum", "format": "title" },
          { "path": "stats.classes", "label": "Classes", "kind": "enum", "format": "title" },
          { "path": "stats.duration.concentration", "label": "Concentration", "kind": "enum" },
          { "path": "stats.ritual", "label": "Ritual", "kind": "enum" },
          { "path": "stats.castingTime.unit", "label": "Casting time", "kind": "enum", "format": "title" }
        ],
        "cardFields": ["stats.level", "stats.school", "stats.duration.concentration", "stats.ritual"],
        "defaultSort": "stats.level:asc",
        "defaultFilters": ["stats.level", "stats.school", "tags.theme"],
        "summaryField": "stats.level",
        "gapBuckets": [
          { "path": "stats.level", "bins": [[0, 0], [1, 3], [4, 6], [7, 9]] },
          {
            "path": "stats.school",
            "enum": ["abjuration", "conjuration", "divination", "enchantment", "evocation", "illusion", "necromancy", "transmutation"]
          }
        ]
      }
    }
  }
}
