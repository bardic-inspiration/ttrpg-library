  "type": "encounter",
  "id": "misshelved-stacks",
  "name": "Misshelved Stacks",
  "summary": "Mimics shelved as books wait in the great hall of stacks, in numbers the DM rolls for.",
  "stats": {
    "setIn": {
      "ref": "map/library-of-tabletop",
      "zone": "the-library"
    },
    "parts": [
      {
        "part": "map",
        "map": {
          "ref": "map/library-of-tabletop",
          "zone": "the-library",
          "show": "thumbnail"
        }
      },
      {
        "part": "description",
        "text": "The shelves climb out of the lamplight, every spine labeled in neat gold letters. One aisle smells faintly of vinegar, and a fat red volume on the third shelf breathes."
      },
      {
        "part": "dm-guide",
        "text": "The anomalies have unsettled the stacks, and {ref:creature/mimic}s have crept in to shelve themselves among the books. Roll on the table when the party first searches an aisle, or choose a row to suit the table. A mimic stuck to a creature keeps the creature {ref:condition/grappled}, so a party that lets the mimics close fights badly. The true books here are the Library's entries; reading one beside the visitor cards from the front hall is how the party learns what a working record looks like."
      },
      {
        "part": "spawn-table",
        "roll": "1d6",
        "rows": {
          "low": {
            "range": {
              "min": 1,
              "max": 2
            },
            "creatures": [
              {
                "ref": "creature/mimic",
                "count": "1d4+1"
              }
            ]
          },
          "moderate": {
