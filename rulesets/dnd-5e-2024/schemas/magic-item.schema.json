{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardic-inspiration.github.io/ttrpg-library/rulesets/dnd-5e-2024/schemas/magic-item.schema.json",
  "title": "dnd-5e-2024 magic item stats (SPEC.md §6.6)",
  "description": "Stored inputs only; magic items derive nothing in v1 except an embedded stat block's ability modifiers and saves (SPEC.md §6.2). saveDc and attackBonus are authored. Cross-field rules are checks in checks.ts (SPEC.md §6.8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "rarity", "attunement", "effect"],
  "properties": {
    "category": {
      "enum": ["armor", "potion", "ring", "rod", "scroll", "staff", "wand", "weapon", "wondrous-item"]
    },
    "baseItem": { "type": "string", "minLength": 1 },
    "rarity": {
      "enum": ["common", "uncommon", "rare", "very-rare", "legendary", "artifact", "varies"]
    },
    "attunement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "requirement": { "type": "string", "minLength": 1 }
      }
    },
    "charges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": {
        "max": {
          "description": "A whole number, or a rolled count as printed: \"1d3\", \"1d8 + 1\".",
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9]\\d*d(2|3|4|6|8|10|12|20|100)( \\+ [1-9]\\d*)?$" }
          ]
        },
        "recharge": { "type": "string", "minLength": 1 },
        "depletion": { "$ref": "common.schema.json#/$defs/Text" }
      }
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spell"],
        "properties": {
          "spell": { "$ref": "common.schema.json#/$defs/RefOrText" },
          "chargeCost": { "type": "integer", "minimum": 1 },
          "maxChargeCost": { "type": "integer", "minimum": 2 },
          "saveDc": { "type": "integer", "minimum": 1 },
          "attackBonus": { "type": "integer" }
        }
      }
    },
    "cursed": { "const": true },
    "effect": { "$ref": "common.schema.json#/$defs/Text" },
    "statBlocks": { "$ref": "common.schema.json#/$defs/StatBlocks" }
  }
}
