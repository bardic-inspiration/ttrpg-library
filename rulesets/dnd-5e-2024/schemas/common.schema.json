{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardic-inspiration.github.io/ttrpg-library/rulesets/dnd-5e-2024/schemas/common.schema.json",
  "title": "dnd-5e-2024 shared definitions (SPEC.md §6.3)",
  "description": "Enums here mirror tables.json; tests/rulesets/dnd-5e-2024/schemas.test.ts keeps them in step.",
  "$defs": {
    "Ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "Dice": { "type": "string", "pattern": "^[1-9]\\d*d(4|6|8|10|12|20|100)$" },
    "Damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "oneOf": [{ "required": ["dice"] }, { "required": ["amount"] }],
      "properties": {
        "dice": { "$ref": "#/$defs/Dice" },
        "amount": { "description": "Flat damage printed without dice, such as \"1 Piercing damage\".", "type": "integer", "minimum": 1 },
        "ability": { "$ref": "#/$defs/Ability" },
        "bonus": { "type": "integer", "not": { "const": 0 } },
        "type": { "$ref": "#/$defs/DamageType" },
        "condition": { "type": "string", "minLength": 1 }
      }
    },
    "Proficiency": { "enum": ["proficient", "expertise"] },
    "Adjust": { "type": "integer", "not": { "const": 0 } },
    "DamageType": {
      "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]
    },
    "Condition": {
      "enum": ["blinded", "charmed", "deafened", "exhaustion", "frightened", "grappled", "incapacitated", "invisible", "paralyzed", "petrified", "poisoned", "prone", "restrained", "stunned", "unconscious"]
    },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "pattern": "^(creature|magic-item|spell)/[a-z0-9-]+$" },
        "note": { "description": "A qualifier printed in parentheses after the target's name, such as \"level 5 version\".", "type": "string", "minLength": 1 }
      }
    },
    "RefOrText": { "anyOf": [{ "$ref": "#/$defs/Ref" }, { "type": "string", "minLength": 1 }] },
    "Text": { "type": "string", "minLength": 1, "markdownSubset": true },
    "Line": { "type": "string", "minLength": 1 },
    "StatBlockItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "text": { "$ref": "#/$defs/Text" }
      }
    },
    "StatBlockItems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StatBlockItem" } },
    "StatBlock": {
      "description": "A stat block printed inside a spell or magic item (SPEC.md §6.6, §6.7). Authored as printed: only the ability modifiers and saves are derived.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "typeLine", "abilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "typeLine": { "$ref": "#/$defs/Line" },
        "ac": { "$ref": "#/$defs/Line" },
        "hp": { "$ref": "#/$defs/Line" },
        "speed": { "$ref": "#/$defs/Line" },
        "abilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["str", "dex", "con", "int", "wis", "cha"],
          "properties": {
            "str": { "type": "integer", "minimum": 1, "maximum": 30 },
            "dex": { "type": "integer", "minimum": 1, "maximum": 30 },
            "con": { "type": "integer", "minimum": 1, "maximum": 30 },
            "int": { "type": "integer", "minimum": 1, "maximum": 30 },
            "wis": { "type": "integer", "minimum": 1, "maximum": 30 },
            "cha": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        },
        "skills": { "$ref": "#/$defs/Line" },
        "vulnerabilities": { "$ref": "#/$defs/Line" },
        "resistances": { "$ref": "#/$defs/Line" },
        "immunities": { "$ref": "#/$defs/Line" },
        "gear": { "$ref": "#/$defs/Line" },
        "senses": { "$ref": "#/$defs/Line" },
        "languages": { "$ref": "#/$defs/Line" },
        "cr": { "$ref": "#/$defs/Line" },
        "traits": { "$ref": "#/$defs/StatBlockItems" },
        "actions": { "$ref": "#/$defs/StatBlockItems" },
        "bonusActions": { "$ref": "#/$defs/StatBlockItems" },
        "reactions": { "$ref": "#/$defs/StatBlockItems" }
      }
    },
    "StatBlocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StatBlock" } }
  }
}
